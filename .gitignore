# 의존성 라이브러리 (용량이 크고 재설치 가능하므로 제외)
node_modules/
jspm_packages/

# 로그 파일 (디버깅 시 생성되는 기록물)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 환경 변수 파일 (보안 민감 정보 - API 키, DB 비밀번호 등)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 빌드 결과물 (배포용으로 생성된 파일들)
dist/
build/
out/

# 운영체제 및 IDE 관련 파일
.DS_Store
.vscode/
.idea/
